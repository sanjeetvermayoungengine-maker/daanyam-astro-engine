# Cloud Run / VM / container — production-oriented template (copy values; do not commit secrets).

ASTRO_BACKEND=de440
VALID_API_KEYS=replace-with-long-random-key
ENVIRONMENT=production

HOST=0.0.0.0
PORT=3000

ASTRO_EPHE_PATH=/tmp/ephe/de440.bsp
ASTRO_EPHE_CACHE_DIR=/tmp/ephe

# Optional: per-API-key requests per rolling 60s (per process). Omit or set 0 to disable.
# RATE_LIMIT_RPM=120

RUST_LOG=warn

# Required for Prometheus / launch-week scrape of GET /metrics (Authorization: Bearer).
METRICS_TOKEN=replace-with-long-random-metrics-token

# Optional: maps x-cloud-trace-context to logging.googleapis.com/* fields in stderr JSON.
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Production convention:
# - Mount de440.bsp read-only at /tmp/ephe/de440.bsp
# - Or set ASTRO_EPHE_PATH=gs://bucket/de440.bsp to download it into ASTRO_EPHE_CACHE_DIR on startup
# - VALID_API_KEYS accepts one or more comma-separated API keys for protected routes
# - Prefer Cloud Run min-instances=1 for production readiness and lower cold-start risk
# - Never commit or bake de440.bsp into source control or the container image

# --- Client-only: used to run `cargo test -p astro-api --test production_contract` against a live URL (not read by the server)
# ASTRO_API_BASE_URL=https://your-cloud-run-url
# ASTRO_API_KEY=<same family of secrets as VALID_API_KEYS>
# Optional: ASTRO_CONTRACT_ASSERT_RATE_LIMIT=1 when the service revision uses a very low RATE_LIMIT_RPM for this check
