ASTRO_BACKEND=de440
HOST=0.0.0.0
PORT=3000
ASTRO_EPHE_PATH=/ephe/de440.bsp
RUST_LOG=info

# Staging convention:
# - Mount de440.bsp read-only into the container at /ephe/de440.bsp
# - For non-container staging, point ASTRO_EPHE_PATH to a local readable path outside the repo
# - For Kubernetes, prefer a PVC-backed mount or other read-only volume over baking the kernel into the image
