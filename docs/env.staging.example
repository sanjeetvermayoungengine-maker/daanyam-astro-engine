# Staging service template (copy values; do not commit real secrets).

ASTRO_BACKEND=de440
VALID_API_KEYS=staging-api-key

HOST=0.0.0.0
PORT=3000

ASTRO_EPHE_PATH=/ephe/de440.bsp
ASTRO_EPHE_CACHE_DIR=/tmp/ephe

# Optional: per-API-key requests per rolling 60s (per process). Omit or set 0 to disable.
# RATE_LIMIT_RPM=120

RUST_LOG=info

# Staging convention:
# - Mount de440.bsp read-only into the container at /ephe/de440.bsp (path may vary)
# - VALID_API_KEYS accepts one or more comma-separated API keys for protected routes
# - For non-container staging, point ASTRO_EPHE_PATH to a local readable path outside the repo
# - For Kubernetes, prefer a PVC-backed mount or other read-only volume over baking the kernel into the image

# --- Client-only: contract tests against the staging URL (not read by the server)
# ASTRO_API_BASE_URL=https://staging-astro-api-url
# ASTRO_API_KEY=staging-api-key
